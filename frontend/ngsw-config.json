{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/i18n/*.json",
          "/fonts/*.woff2"
        ]
      }
    },
    {
      "name": "icons",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/*.png", "/icons/*.svg"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/admin/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
